# 이 파일을 복사해서 .env.local 로 이름 바꾸고, 실제 키를 넣어주세요.
# .env.local은 절대 GitHub에 올리지 마세요 (.gitignore에 이미 등록됨).

ANTHROPIC_API_KEY=여기에_발급받은_API_키_붙여넣기

# PayPal 설정
# developer.paypal.com → Apps & Credentials 에서 발급받은 값들
NEXT_PUBLIC_PAYPAL_CLIENT_ID=여기에_Client_ID_붙여넣기
PAYPAL_CLIENT_SECRET=여기에_Secret_붙여넣기

# sandbox(테스트) 또는 live(실제 결제). 처음엔 sandbox로 두세요.
PAYPAL_ENV=sandbox
